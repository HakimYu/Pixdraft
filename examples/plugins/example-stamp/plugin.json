{
  "id": "com.example.stamp",
  "name": "示例水印插件",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "index.js",
  "permissions": {
    "credentials": [],
    "image": true
  },
  "processors": [
    {
      "id": "example.stamp",
      "name": "示例水印",
      "process": "stamp",
      "fields": [
        {"key": "text", "label": "水印文字", "type": "text", "defaultValue": "示例工作室"},
        {"key": "opacity", "label": "不透明度", "type": "number", "defaultValue": 0.6, "min": 0.1, "max": 1}
      ]
    }
  ],
  "tools": [
    {
      "id": "tool.stamp",
      "name": "示例水印工具",
      "processorId": "example.stamp",
      "fields": [
        {"key": "text", "label": "水印文字", "type": "text", "defaultValue": "示例工作室"}
      ]
    }
  ]
}